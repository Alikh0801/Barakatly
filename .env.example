# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile — login captcha (optional; sign-in works without it)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Telegram alerts for admins (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_IDS=

# Test site (pre.barakatly.az) only
# NEXT_PUBLIC_APP_ENV=pre
# SUPABASE_SERVICE_ROLE_KEY_PRE=
# PRE_ACCESS_USER=
# PRE_ACCESS_PASSWORD=
# TELEGRAM_SEND_ON_PRE=true
